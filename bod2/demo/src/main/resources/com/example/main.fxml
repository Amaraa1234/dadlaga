<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="500.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.Controller">
   <children>
      <VBox alignment="CENTER" spacing="5.0">
         <children>
            <Label text="Бодлого 7034" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label text="Өгөгдсөн 2 бодит эерэг тооны арифметик болон геометр дунджийг олно" textAlignment="CENTER" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>
      
      <TextField fx:id="txtNum1" maxWidth="250.0" prefHeight="35.0" promptText="Эхний тоо" style="-fx-font-size: 14px;" />
      <TextField fx:id="txtNum2" maxWidth="250.0" prefHeight="35.0" promptText="Хоёр дахь тоо" style="-fx-font-size: 14px;" />
      
      <Button mnemonicParsing="false" onAction="#onCalculateClick" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5;" text="Бодолт" />
      
      <Label fx:id="lblResult" alignment="CENTER" contentDisplay="CENTER" maxWidth="350.0" prefHeight="60.0" text="Үр дүн энд харагдана" textAlignment="CENTER" wrapText="true">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>