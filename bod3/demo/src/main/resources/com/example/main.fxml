<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller">
   <children>
      <!-- Үндсэн агуулагч VBox (Гарчиг болон доод талын HBox-ийг дээр дороос нь цувуулж байрлуулна) -->
      <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            
            <!-- Дээд хэсэгт шинээр нэмэгдсэн гарчиг -->
            <Label text="Бодлого 7582 ЭЕШ" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </Label>
            
            <!-- Таны өмнөх үндсэн HBox бүтэц (Яг хэвээрээ) -->
            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  
                  <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Сурагчдын дүн">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <TableView fx:id="studentTableView" prefHeight="400.0" prefWidth="400.0" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="statusColumn" prefWidth="50.0" text="№" />
                            <TableColumn fx:id="nameColumn" prefWidth="120.0" text="ner" />
                            <TableColumn fx:id="idColumn" prefWidth="100.0" text="kod" />
                            <TableColumn fx:id="scoreColumn" prefWidth="80.0" text="onoo" />
                          </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
                  
                  <VBox prefWidth="250.0" spacing="15.0">
                     <children>
                        <Label text="Сурагч шинээр нэмэх">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                        </Label>
                        
                        <TextField fx:id="inputName" promptText="Сурагчийн нэр" />
                        <TextField fx:id="inputCode" promptText="Оюутны код (Жишээ нь: nj1)" />
                        <TextField fx:id="inputScore" promptText="Шалгалтын оноо (0-100)" />
                        
                        <Button fx:id="addButton" maxWidth="1.7976931348623157E308" onAction="#onAddStudent" text="Сурагч нэмэх" />
                     </children>
                  </VBox>
                  
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>