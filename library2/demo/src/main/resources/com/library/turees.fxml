<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="280.0" prefWidth="400.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.controllers.MainController">
   <children>
      <VBox layoutX="20.0" layoutY="20.0" spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <Label text="Шинэ түрээс бүртгэх" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <VBox spacing="5.0">
               <children>
                  <Label text="Уншигч сонгох:" />
                  <ComboBox fx:id="cmbMember" maxWidth="1.7976931348623157E308" prefHeight="35.0" promptText="-- Уншигч сонгох --" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Ном сонгох:" />
                  <ComboBox fx:id="cmbBook" maxWidth="1.7976931348623157E308" prefHeight="35.0" promptText="-- Ном сонгох --" />
               </children>
            </VBox>
            <Button fx:id="btnSubmitRent" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onConfirmRentClick" prefHeight="40.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="ТҮРЭЭСЛҮҮЛЭХ">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>